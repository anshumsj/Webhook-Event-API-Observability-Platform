# ==============================================================================
# HookSight Backend Configuration Template
# ==============================================================================

# Port the Express API server listens on
PORT=3001

# Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Primary MongoDB Connection URI
# Default local port: 27017 (native) or 27018 (Docker Compose host exposure)
MONGODB_URI=mongodb://127.0.0.1:27017/webhookObservability

# Optional MongoDB Connection URI specifically for the test runner (run-all-tests.js)
# Defaults to mongodb://127.0.0.1:27018/webhookObservability if unset
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/webhookObservability

# Redis Connection URL (for BullMQ queue and rate-limiting stores)
# Default local port: 6379 (native) or 6380 (Docker Compose host exposure)
REDIS_URL=redis://127.0.0.1:6379

# Cryptographic Secret for JWT Access Tokens (Server fails-closed if undefined)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Comma-separated list of allowed CORS origins
# In development, http://localhost:* is automatically permitted.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
